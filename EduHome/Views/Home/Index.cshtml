@using System.Globalization;
@model HomeVM
@{
    CultureInfo englishCulture = new CultureInfo("en-US");
}
<section id="slider-container" class="slider-area">
    <div class="slider-owl owl-theme owl-carousel">
        <!-- Start Slingle Slide -->
        @foreach (var img in Model.Sliders)
        {
            <div class="single-slide item" style="background-image: url(img/slider/@img.ImgUrl)">
                <!-- Start Slider Main -->
                <div class="slider-content-area">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-7 col-md-offset-left-5">
                                <div class="slide-content-wrapper text-left">
                                    <div class="slide-content">
                                        <h3>@img.Title </h3>
                                        <p>@img.Desc</p>
                                        <a class="default-btn" href="about.html">Learn more</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
        }
    </div>
</section>
<!-- Background Area End -->
<!-- Notice Start -->
<section class="notice-area pt-150 pb-150">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-sm-6 col-xs-12">
                <div class="notice-left">
                    <h3>notice board</h3>
                    @foreach (var item in Model.Events)
                    {
                        <a asp-controller="event" asp-action="detail" asp-route-id="@item.Id">
                            <div class="single-notice-left mb-25 pb-25">
                                <h4>@item.Time.ToString("MMM dd, yyyy",englishCulture) </h4>
                                <p>@item.Desc </p>
                            </div>
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-6 col-sm-6 col-xs-12">
                <div class="notice-right">
                    <div class="single-notice-right mb-25 pb-25">
                        <h3>@Model.WebSettings.FirstOrDefault(s=>s.Key=="SettingsTitle").Value</h3>
                        <p>@Model.WebSettings.FirstOrDefault(s=>s.Key=="SettingsDesc").Value </p>
                    </div>
                    <div class="single-notice-right mb-25 pb-25">
                        <h3>@Model.WebSettings.FirstOrDefault(s=>s.Key=="SettingsTitlee").Value</h3>
                        <p>@Model.WebSettings.FirstOrDefault(s=>s.Key=="SettingsDescc").Value</p>
                    </div>
                    <div class="single-notice-right">
                        <h3>@Model.WebSettings.FirstOrDefault(s=>s.Key=="SettingsTitles").Value</h3>
                        <p>@Model.WebSettings.FirstOrDefault(s=>s.Key=="SettingsDescs").Value</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Notice End -->
<!-- Choose Start -->
<section class="choose-area pb-85 pt-77">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-left-4 col-sm-8 col-md-offset-left-4">
                <div class="choose-content text-left">
                    <h2>@Model.WebSettings.FirstOrDefault(s=>s.Key=="CourseTitle").Value</h2>
                    <p>@Model.WebSettings.FirstOrDefault(s=>s.Key=="CourseDesc").Value</p>
                    <p class="choose-option">@Model.WebSettings.FirstOrDefault(s=>s.Key=="CourseDescNext").Value</p>
                    <a class="default-btn" href="course-details.html">view courses</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Choose Area End -->
<!-- Courses Area Start -->
<div class="courses-area pt-150 text-center">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="section-title">
                    <img src="img/icon/section.png" alt="section-title">
                    <h2>COURSES WE OFFER</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach(var item in Model.Courses)
            {
                <div class="col-md-4 col-sm-6 col-xs-12">
                    <div class="single-course">
                        <div class="course-img">
                            <a href="course-details.html">
                                <img src="~/img/course/@item.ImgUrl" alt="course">
                                <div class="course-hover">
                                    <i class="fa fa-link"></i>
                                </div>
                            </a>
                        </div>
                        <div class="course-content">
                            <h3><a href="course-details.html">@item.Name</a></h3>
                            <p>@item.Desc</p>
                            <a class="default-btn" href="course-details.html">read more</a>
                        </div>
                    </div>
                </div>
            }
                </div>
            </div>
        </div>
 
<!-- Courses Area End -->
<!-- Event Area Start -->
<div class="event-area one text-center pt-140 pb-150">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="section-title">
                    <img src="img/icon/section.png" alt="section-title">
                    <h2>UPCOMMING EVENTS</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model.Events)
            {
                 <div class="col-md-6 col-sm-12 col-xs-12">
                <div class="single-event mb-35">
                    <div class="event-date">
                            <h3><a href="event-details.html">@item.Time.ToString("MMM dd",englishCulture)</a></h3>
                    </div>
                    <div class="event-content text-left">
                        <div class="event-content-left">
                            <h4><a href="event-details.html">@item.Name</a></h4>
                            <ul>
                                    <li><i class="fa fa-clock-o"></i>@item.Time.ToString("h:mm tt-h:mm-tt")</li>
                                <li><i class="fa fa-map-marker"></i>@item.Area</li>
                            </ul>
                        </div>
                        <div class="event-content-right">
                            <a class="default-btn" href="event-details.html">join now</a>
                        </div>
                    </div>
                </div>
               
               </div>       
            }
        </div>
            </div>
        </div>
   
<!-- Event Area End -->
<!-- Testimonial Area Start -->
<div class="testimonial-area pt-110 pb-105 text-center">
    <div class="container">
        <div class="row">
            @foreach(var item in Model.Testimonials)
            {
                <div class="testimonial-owl owl-theme owl-carousel">
                    <div class="col-md-8 col-md-offset-2 col-sm-12">
                        <div class="single-testimonial">
                            <div class="testimonial-info">
                                <div class="testimonial-img">
                                    <img src="~/img/testimonial/@item.ImgUrl" alt="testimonial">
                                </div>
                                <div class="testimonial-content">
                                    <p>@item.Desc</p>
                                    <h4>@item.Name</h4>
                                    <h5>@item.Work</h5>
                                </div>
                            </div>
                        </div>
                              </div>
    </div>
            }
        </div>
        </div>
        </div>
  
<!-- Testimonial Area End -->
<!-- Blog Area Start -->
<div class="blog-area pt-150 pb-150">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="section-title text-center">
                    <img src="img/icon/section.png" alt="section-title">
                    <h2>LATEST FROM BLOG</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach(var item in Model.Blogs)
            {
                <div class="col-md-4 col-sm-6 col-xs-12">
                    <div class="single-blog">
                        <div class="blog-img">
                            <a href="blog-details.html"><img src="~/img/blog/@item.ImgUrl" alt="blog"></a>
                            <div class="blog-hover">
                                <a href="blog-details.html"><i class="fa fa-link"></i></a>
                            </div>
                        </div>
                        <div class="blog-content">
                            <div class="blog-top">
                                <p>@item.Name  /  @item.Time.ToString("MMM dd, yyyy",englishCulture)  /  <i class="fa fa-comments-o"></i> @item.Comment</p>
                            </div>
                            <div class="blog-bottom">
                                <h2><a href="blog-details.html">@item.Desc </a></h2>
                                <a href="blog-details.html">read more</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
                    </div>
                </div>
            </div>
  
<!-- Blog Area End -->
<!-- Subscribe Start -->
<div class="subscribe-area pt-60 pb-70">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="subscribe-content section-title text-center">
                    <h2>Subscribe to our newsletter</h2>
                    <p>Stay updated with our latest news and offers.</p>
                </div>
                <div class="newsletter-form">
                    <form action="/subscribe" method="post" id="subscribe-form" novalidate>
                        <div id="subscribe-form-content" class="mc-form">
                            <input type="email" name="Email" class="email" placeholder="Enter your e-mail address" required>
                            <button class="default-btn" type="submit"><span>Subscribe</span></button>
                        </div>
                    </form>
                    <div class="alerts">
                        <div class="submitting" style="display: none;">Submitting...</div>
                        <div class="success" style="display: none;">Subscribed successfully!</div>
                        <div class="error" style="display: none;">An error occurred. Please try again.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Subscribe End -->