@model ChangePasswordVM

@{
    ViewData["Title"] = "Şifrə Dəyiş";
}

<div class="container changepassword">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg p-4 animated-card bg-light">
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <h2 class="text-center mb-4 font-weight-bold animated-heading">Change Password</h2>
                    <form asp-action="ChangePassword" asp-controller="Account" method="post">
                        <div class="form-group position-relative">
                            <label for="currentPassword" class="font-weight-medium">Current Password</label>
                            <input type="password" class="form-control form-control-lg rounded-pill" id="currentPassword" name="CurrentPassword" placeholder="Current Password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                            <span class="position-absolute toggle-password" style="right: 15px; top: 38px; cursor: pointer;">
                                <i class="fa fa-eye"></i>
                            </span>
                        </div>

                        <div class="form-group position-relative">
                            <label for="newPassword" class="font-weight-medium">New Password</label>
                            <input type="password" class="form-control form-control-lg rounded-pill" id="newPassword" name="NewPassword" placeholder="New Password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <span class="position-absolute toggle-password" style="right: 15px; top: 38px; cursor: pointer;">
                                <i class="fa fa-eye"></i>
                            </span>
                        </div>

                        <div class="form-group position-relative">
                            <label for="confirmNewPassword" class="font-weight-medium">Confirm New Password</label>
                            <input type="password" class="form-control form-control-lg rounded-pill" id="confirmNewPassword" name="ConfirmNewPassword" placeholder="Confirm New Password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                            <span class="position-absolute toggle-password" style="right: 15px; top: 38px; cursor: pointer;">
                                <i class="fa fa-eye"></i>
                            </span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg btn-block rounded-pill">Change Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            $(".toggle-password").click(function () {
                let input = $(this).siblings("input");
                let icon = $(this).find("i");
                if (input.attr("type") === "password") {
                    input.attr("type", "text");
                    icon.removeClass("fa-eye").addClass("fa-eye-slash");
                } else {
                    input.attr("type", "password");
                    icon.removeClass("fa-eye-slash").addClass("fa-eye");
                }
            });
        });
    </script>
}
