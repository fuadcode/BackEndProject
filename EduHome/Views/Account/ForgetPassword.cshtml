 @model LoginVM
<!-- Banner Area Start -->
<div class="banner-area-wrapper">
    <div class="banner-area text-center">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="banner-content-wrapper">
                        <div class="banner-content">
                            <h2>Forget Password?</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Banner Area End -->
<!-- Login start -->
<div class="login-area pt-150 pb-150">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-offset-3 text-center">
                <div class="login">
                    <div class="login-form-container">

                        <div class="login-text">
                            <h2>Forget Password</h2>
                            <span>Please enter your Email address bellow.</span>
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>

                        <div class="login-form">
                            <form method="post">
                                <input name="email" placeholder="Enter your Email" />
                                <span class="text-danger">
                                    @Html.ValidationMessage("Error1")
                                </span>
                                <button type="submit" class="btn-block default-btn ">Send Email</button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Login end -->
<!-- Subscribe Start -->
<div class="subscribe-area pt-60 pb-70">
    <div class="container">
        <div class="row">
            @await Component.InvokeAsync("Subscription")
        </div>
    </div>
</div>
    </div>
</div>
<!-- Subscribe End -->