@model ResetPasswordVM
@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
}

<style>
    .reset-password-container {
        max-width: 500px;
        margin: auto;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        background-color: #f9f9f9;
    }

        .reset-password-container h1 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
            color: #555;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

            .form-group input:focus {
                border-color: #007bff;
                outline: none;
            }

    .text-danger {
        color: #e3342f;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 16px;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }
</style>

<div class="reset-password-container">
    <h1>Reset Password</h1>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form method="post">
        <div class="form-group">
            <label for="Password">Enter your new password</label>
            <input asp-for="Password" id="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="RePassword">Confirm your new password</label>
            <input asp-for="RePassword" id="RePassword" class="form-control" />
            <span asp-validation-for="RePassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button class="btn btn-primary" type="submit">Reset your password</button>
        </div>
    </form>
</div>
