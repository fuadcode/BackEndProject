@model List<BasketVM>

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-primary text-white border-0 rounded-top">
            <h5 class="mb-0">Course Basket</h5>
        </div>
        <div class="card-body p-4">
            <table class="table table-hover align-middle">
                <thead class="bg-light">
                    <tr>
                        <th scope="col">Image</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                        <th scope="col">Basket Count</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>
                                <img src="~/img/course/@course.ImageUrl" class="img-thumbnail rounded-circle shadow-sm" width="80" height="80" alt="@course.Name" />
                            </td>
                            <td class="fw-bold">@course.Name</td>
                            <td>@course.Desc</td>
                            <td class="text-center">@course.BasketCount</td>
                            <td>
                                <a asp-action="DeleteCourseFromBasket" asp-route-id="@course.Id" class="btn btn-outline-danger btn-action">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                                <a asp-action="ProcessPayment" asp-route-id="@course.Id" class="btn btn-outline-danger btn-action">
                                    <i class="fas fa-trash-alt"></i>  Pay Now
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        background-color: #ffffff;
    }

    .card-header {
        background: linear-gradient(135deg, #007bff, #0056b3);
        border-bottom: none;
        padding: 20px;
    }

    .card-body {
        padding: 20px;
    }

    .table {
        margin-bottom: 0;
        border-radius: 10px;
        background-color: #fff;
    }

        .table thead th {
            color: #495057;
            font-weight: bold;
            text-transform: uppercase;
        }

        .table tbody tr:hover {
            background-color: #f9f9f9;
        }

        .table tbody td {
            vertical-align: middle;
        }

    .img-thumbnail {
        border: 1px solid #ddd;
        padding: 6px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    }

    .btn-action {
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem; 
        border-radius: 0.375rem; 
        display: inline-flex;
        align-items: center;
        text-align: center;
        vertical-align: middle;
        transition: background-color 0.3s, border-color 0.3s, color 0.3s;
        margin-right: 0.5rem;
    }

    .btn-outline-danger {
        border-color: #dc3545;
        color: #dc3545;
    }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: #fff;
        }


    .btn i {
        margin-right: 0.5rem;
    }

    .shadow-lg {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .rounded-pill {
        border-radius: 50rem;
    }
</style>
