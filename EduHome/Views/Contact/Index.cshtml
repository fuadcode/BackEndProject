@model Dictionary<string,string>

    <!-- Banner Area Start -->
<div class="banner-area-wrapper">
    <div class="banner-area text-center">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="banner-content-wrapper">
                        <div class="banner-content">
                            <h2>contact</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Banner Area End -->
<!-- Contact Start -->
<div class="map-area">
    <!-- google-map-area start -->
    <div class="google-map-area">
        <!--  Map Section -->
        <div id="contacts" class="map-area">
            @* <div id="googleMap" style="width:100%;height:440px;"></div> *@
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12154.788832926788!2d49.786251445381694!3d40.39340298564364!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40308771f64ee487%3A0xd17196b8b4c03e2a!2sYeni%20Yasamal%2C%20Baku!5e0!3m2!1sen!2saz!4v1721755615995!5m2!1sen!2saz" height="450" style="border:0; width: 100%;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>
</div>
<div class="contact-area pt-150 pb-140">
    <div class="container">
        <div class="row">
            <div class="col-md-5 col-sm-5 col-xs-12">
                <div class="contact-contents text-center">
                    <div class="single-contact mb-65">
                        <div class="contact-icon">
                            <img src="~/img/contact/contact1.png" alt="contact">
                        </div>
                        <div class="contact-add">
                            <h3>address</h3>
                            <p>@Model["Adress"]</p>
                            
                        </div>
                    </div>
                    <div class="single-contact mb-65">
                        <div class="contact-icon">
                            <img src="~/img/contact/contact2.png" alt="contact">
                        </div>
                        <div class="contact-add">
                            <h3>Phone</h3>
                            <p>@Model["PhoneNumber"]</p>
                           
                        </div>
                    </div>
                    <div class="single-contact">
                        <div class="contact-icon">
                            <img src="~/img/contact/contact3.png" alt="contact">
                        </div>
                        <div class="contact-add">
                            <h3>Email</h3>
                            <p>@Model["ContactMail"]</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-7 col-sm-7 col-xs-12">
                <div class="reply-area">
                    <h3>LEAVE A MESSAGE</h3>
                    <form id="contact-form" action="/Home/SubmitContactForm" method="post">
                        <div class="row">
                            <div class="col-md-12">
                                <p>Name</p>
                                <input type="text" name="Name" id="name" required>
                            </div>
                            <div class="col-md-12">
                                <p>Email</p>
                                <input type="email" name="Email" id="email" required>
                            </div>
                            <div class="col-md-12">
                                <p>Subject</p>
                                <input type="text" name="Subject" id="subject" required>
                                <p>Message</p>
                                <textarea name="Message" id="message" cols="15" rows="10" required></textarea>
                            </div>
                        </div>
                        <button type="submit" class="reply-btn">Send Message</button>
                      
                    </form>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-@TempData["MessageType"]">
                            @TempData["Message"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact End -->
<!-- Subscribe Start -->
<div class="subscribe-area pt-60 pb-70">
    <div class="container">
        <div class="row">
            @await Component.InvokeAsync("Subscription")
        </div>
    </div>
</div>
    </div>
</div>
<!-- Subscribe End -->

<style>
    .response-message {
        padding: 10px;
        margin-top: 10px;
        border-radius: 5px;
    }

        .response-message.success {
            background-color: #d4edda;
            color: #155724;
        }

        .response-message.error {
            background-color: #f8d7da;
            color: #721c24;
        }
</style>