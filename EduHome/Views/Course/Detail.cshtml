@model CourseVM
@using System.Globalization
@{
    CultureInfo englishCulture = new CultureInfo("en-US");
}
<!-- Banner Area Start -->
<div class="banner-area-wrapper">
    <div class="banner-area text-center">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <div class="banner-content-wrapper">
                        <div class="banner-content">
                            <h2>courses details</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Banner Area End -->
<!-- Blog Start -->
<div class="courses-details-area blog-area pt-150 pb-140">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="courses-details">
                    <div class="courses-details-img">
                        <img src="~/img/course/courses-details.jpg" alt="courses-details">
                    </div>
                    <div class="course-details-content">
                        <h2>@Model.Course.Name</h2>
                        <p>@Model.Course.Desc</p>
                        <div class="course-details-left">
                            <div class="single-course-left">
                                <h3>@Model.Course.About</h3>
                                <p>@Model.Course.Desc</p>
                            </div>
                            <div class="single-course-left">
                                <h3>@Model.Course.Apply</h3>
                                <p>@Model.Course.Desc</p>
                            </div>
                            <div class="single-course-left">
                                <h3>@Model.Course.Certification</h3>
                                <p class="margin">@Model.Course.Desc</p>
                                <p>@Model.Course.Desc</p>
                            </div>
                        </div>
                       
                        <div class="course-details-right">
                            <h3>COURSE FEATURES</h3>
                            <ul>
                                @foreach (var features in Model.Features)
                                {
                                    <li>starts <span>@features.StartDate.ToString("dd,MMMM yyyy")</span></li>
                                    <li>duration <span>@features.Duration</span></li>
                                    <li>class duration <span>@features.ClassDuration</span></li>
                                    <li>skill level <span>@features.SkillLevel</span></li>
                                    <li>language <span>@features.Language</span></li>
                                    <li>students <span>@features.StudentCount</span></li>
                                    <li>assesments <span>@features.Assesment</span></li>
                                    <h3 class="red">course fee $@features.Price</h3>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="reply-area">
                        <h3>LEAVE A REPLY</h3>
                        <p>@Model.Course.Desc</p>
                        <form id="contact-form" action="/Home/SubmitContactForm" method="post">
                            <div class="row">
                                <div class="col-md-12">
                                    <p>Name</p>
                                    <input type="text" name="name" id="name" required>
                                </div>
                                <div class="col-md-12">
                                    <p>Email</p>
                                    <input type="email" name="email" id="email" required>
                                </div>
                                <div class="col-md-12">
                                    <p>Subject</p>
                                    <input type="text" name="subject" id="subject" required>
                                    <p>Message</p>
                                    <textarea name="message" id="message" cols="15" rows="10" required></textarea>
                                </div>
                            </div>
                            <button type="submit" class="reply-btn">Send Message</button>
                            @if (TempData["Message"] != null)
                            {
                                <div class="response-message @(TempData["MessageType"])">
                                    @TempData["Message"]
                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="blog-sidebar right">
                    <div class="single-blog-widget mb-50">
                        <h3>search</h3>
                        <div class="blog-search">
                            <form id="search" action="#">
                                <ul class="list-unstyled py-3" id="searchList">
                                    <li>
                                        <input type="search" placeholder="Search..." id="input-search" name="search" />
                                    </li>
                                </ul>
                                <button type="submit">
                                    <span><i class="fa fa-search"></i></span>
                                </button>
                            </form>


                        </div>
                    </div>
                    <div class="single-blog-widget mb-50">
                        <h3>categories</h3>
                        <ul>
                            @foreach (var item in Model.Categories)
                            {
                                <li><a asp-controller="Course" asp-action="detail" asp-route-id="@item.Id">@item.Name (@item.Course.Count)</a></li>
                            }
                        </ul>
                    </div>
                    <div class="single-blog-widget mb-50">
                        <div class="single-blog-banner">
                            <a href="blog/detail" id="blog"><img src="~/img/blog/blog-img.jpg" alt="blog"></a>
                            <h2>best<br> eductaion<br> theme</h2>
                        </div>
                    </div>
                    <div class="single-blog-widget mb-50">
                        <h3>latest post</h3>
                        @foreach (var blog in Model.Blogs)
                        {
                            <div class="single-post mb-30">
                                <div class="single-post-img">
                                    <a href="/blog/detail/@blog.Id">
                                        <img src="~/img/blog/@blog.ImgUrl" width="80" height="80" alt="post">
                                        <div class="blog-hover">
                                            <i class="fa fa-link"></i>
                                        </div>
                                    </a>
                                </div>
                                <div class="single-post-content">
                                    <h4><a href="/blog/detail/@blog.Id">English Language Course for you</a></h4>
                                    <p>@blog.Name  /  @blog.Time.ToString("MMM dd, yyyy", englishCulture)</p>
                                </div>
                            </div>
                        }
                    </div>
                
                    <div class="single-blog-widget">
                        <h3>tags</h3>
                        <div class="single-tag">
                            <a asp-controller="blog" asp-action="detail" asp-route-id="1" class="mr-10 mb-10">course</a>
                            <a asp-controller="blog" asp-action="detail" asp-route-id="1" class="mr-10 mb-10">education</a>
                            <a asp-controller="blog" asp-action="detail" asp-route-id="1" class="mb-10">teachers</a>
                            <a asp-controller="blog" asp-action="detail" asp-route-id="1" class="mr-10">learning</a>
                            <a asp-controller="blog" asp-action="detail" asp-route-id="1" class="mr-10">university</a>
                            <a asp-controller="blog" asp-action="detail" asp-route-id="1">events</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Blog End -->
<!-- Subscribe Start -->
<div class="subscribe-area pt-60 pb-70">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="subscribe-content section-title text-center">
                    <h2>Subscribe to our newsletter</h2>
                    <p>Stay updated with our latest news and offers.</p>
                </div>
                <div class="newsletter-form">
                    <form action="/subscribe" method="post" id="subscribe-form" novalidate>
                        <div id="subscribe-form-content" class="mc-form">
                            <input type="email" name="Email" class="email" placeholder="Enter your e-mail address" required>
                            <button class="default-btn" type="submit"><span>Subscribe</span></button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Subscribe End -->

