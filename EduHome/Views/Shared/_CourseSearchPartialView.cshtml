@model IEnumerable<Course>

@if (Model.Any())
{
    <ul>
        @foreach (var course in Model)
        {
            <li>@course.Name</li>
            <li>@course.Desc</li>
            <img src="img/course/@course.ImgUrl" alt="@course.Name">
        }
    </ul>
}
else
{
    <p>No courses found</p>
}
