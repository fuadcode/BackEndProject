@model IEnumerable<Teacher>
@foreach (var teacher in Model)
{
    <div class="col-md-3 col-sm-4 col-xs-12">
        <div class="single-teacher mb-45">
            <div class="single-teacher-img">
                <a href="teacher/detail/@teacher.Id"><img src="~/img/teacher/@teacher.ImgUrl" alt="teacher"></a>
            </div>
            <div class="single-teacher-content text-center">
                <h2><a href="teacher/detail/@teacher.Id">@teacher.Name</a></h2>
                <h4>@teacher.Position</h4>
                <ul>
                    <li><a href="https://www.linkedin.com/in/fuad-isk%C9%99nd%C9%99rov"><i class="zmdi zmdi-facebook"></i></a></li>
                    <li><a href="https://github.com/fuadcode"><i class="zmdi zmdi-pinterest"></i></a></li>
                    <li><a href="#"><i class="zmdi zmdi-vimeo"></i></a></li>
                    <li><a href="https://twitter.com/devitemsllc"><i class="zmdi zmdi-twitter"></i></a></li>
                </ul>
            </div>
        </div>
    </div>
}