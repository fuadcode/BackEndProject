@model Dictionary<string,string>
<header class="top">
    <div class="header-top">
        <div class="container">
            <div class="row">
                <div class="col-md-8 col-sm-8 col-xs-12">
                    <div class="header-top-left">
                        <p>HAVE ANY QUESTION ?  +880 5698  598  6587</p>
                    </div>
                </div>
                <div class="col-md-4 col-sm-4 col-xs-12">
                    <div class="header-top-right text-right">
                        <ul>
                            <li><a asp-controller="account" asp-action="Login">login</a></li>
                            <li><a asp-controller="account" asp-action="Register">signup</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="header-area two header-sticky">
        <div class="container">
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-6">
                    <div class="logo">
                        <a href="index.html"><img src="~/img/logo/@Model["Logo"]" alt="eduhome" /></a>
                    </div>
                </div>
                <div class="col-md-9 col-sm-9 col-xs-6">
                    <div class="content-wrapper text-right">
                        <!-- Main Menu Start -->
                        <div class="main-menu">
                            <nav>
                                <ul>
                                    <li>
                                        <a asp-controller="home" asp-action="Index">Home</a>
                                        <ul>
                                            <li><a asp-controller="home" asp-action="Index">Home One</a></li>
                                        </ul>
                                    </li>
                                    <li><a asp-controller="about" asp-action="Index">About</a></li>
                                    <li>
                                        <a asp-controller="course" asp-action="Index">courses</a>
                                        <ul>
                                            <li><a asp-controller="course" asp-action="Index">courses</a></li>
                                            <li><a asp-controller="course" asp-action="detail" asp-route-id="1">courses details</a></li>

                                        </ul>
                                    </li>
                                    <li>
                                        <a asp-controller="event" asp-action="Index">event</a>
                                        <ul>
                                            <li><a asp-controller="event" asp-action="Index">event</a></li>
                                            <li><a asp-controller="event" asp-action="detail" asp-route-id="1">events details</a></li>
                                        </ul>
                                    </li>
                                    <li class="hidden-sm">
                                        <a asp-controller="teacher" asp-action="Index">teacher</a>
                                        <ul>
                                            <li><a asp-controller="teacher" asp-action="Index">teacher</a></li>
                                            <li><a asp-controller="teacher" asp-action="detail" asp-route-id="1">teacher details</a></li>
                                        </ul>
                                    </li>
                                    <li>
                                        <a asp-controller="blog" asp-action="Index">blog</a>
                                        <ul>
                                            <li><a asp-controller="blog" asp-action="Index">blog</a></li>
                                            <li><a asp-controller="blog" asp-action="Detail" asp-route-id="1">blog details</a></li>
                                        </ul>
                                    </li>
                                    <li><a asp-controller="contact" asp-action="Index">Contact</a></li>
                                    <li><a href="#">Buy Now</a>
                                </ul>
                            </nav>
                        </div>
                        <!--Search Form Start-->
                        <div class="search-btn">
                            <ul data-toggle="dropdown" class="header-search search-toggle">
                                <li class="search-menu">
                                    <i class="fa fa-search"></i>
                                </li>
                            </ul>
                            <div class="search">
                                <div class="search-form">
                                    <form id="search-form" action="#">
                                        <input type="search" placeholder="Search here..." name="search" />
                                        <button type="submit">
                                            <span><i class="fa fa-search"></i></span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <!--End of Search Form-->
                        <!-- Main Menu End -->
                    </div>
                </div>
                <div class="col-xs-12">
                    <div class="mobile-menu hidden-lg hidden-md hidden-sm"></div>
                </div>
            </div>
        </div>
    </div>
</header>