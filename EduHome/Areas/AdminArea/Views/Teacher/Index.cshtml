@using EduHome.Areas.AdminArea.ViewModels.TeacherVMs
@model PaginationVM<TeacherListVM>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card border-0 shadow-sm rounded-lg">
                <div class="card-body p-4">
                    <h4 class="card-title text-primary mb-4">Teacher List</h4>
                    <a class="btn btn-primary mb-3" asp-action="create">
                        <i class="mdi mdi-plus-circle"></i> Create
                    </a>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Position</th>

                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var teacher in Model)
                                {
                                    <tr>
                                        <td>
                                            <img src="~/img/teacher/@teacher.ImgUrl" class="rounded-circle" style="width: 100px; height: 100px;" alt="Teacher Image">
                                        </td>
                                        <td>@teacher.Name</td>
                                        <td>@teacher.Position</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-success" asp-action="detail" asp-route-id="@teacher.Id">
                                                <i class="mdi mdi-eye"></i> View
                                            </a>
                                            <a class="btn btn-sm btn-outline-primary" asp-action="update" asp-route-id="@teacher.Id">
                                                <i class="mdi mdi-pencil"></i> Edit
                                            </a>
                                            <a class="btn btn-sm btn-outline-danger" asp-action="delete" asp-route-id="@teacher.Id">
                                                <i class="mdi mdi-delete"></i> Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination Section -->
    <div class="row justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-md">
                <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true" class="pagination-icon">&laquo;</span>
                        <span class="sr-only">Previous</span>
                    </a>
                </li>
                @for (int i = Model.Start; i <= Model.End; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)" aria-label="Next">
                        <span aria-hidden="true" class="pagination-icon">&raquo;</span>
                        <span class="sr-only">Next</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<style>
    .pagination {
        display: flex;
        justify-content: center;
        padding: 1rem;
    }

        .pagination .page-item {
            margin: 0 0.2rem;
        }

        .pagination .page-link {
            border-radius: 0.375rem;
            border: 1px solid #dee2e6;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: #007bff;
            background-color: #fff;
        }

            .pagination .page-link:hover {
                background-color: #e9ecef;
                color: #0056b3;
            }

        .pagination .page-item.active .page-link {
            background-color:red;
            color: #fff;
            border-color:black;
        }

        .pagination .page-item.disabled .page-link {
            color: #6c757d;
            cursor: not-allowed;
        }

    .pagination-icon {
        font-size: 1.2rem;
    }
</style>
