@using EduHome.Areas.AdminArea.ViewModels.SpeakerVMs
@model SpeakerUpdateVM

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-4 text-center">Update Speaker Details</h4>
                    <div class="text-center mb-4">
                        <img src="~/img/event/@Model.Image" width="100" height="150" class="img-thumbnail" />
                    </div>
                    <form enctype="multipart/form-data" asp-action="update" method="post" class="forms-sample">
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Name">
                            <span class="text-danger" asp-validation-for="Name"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Position" class="form-label"></label>
                            <input asp-for="Position" class="form-control" placeholder="Position">
                            <span class="text-danger" asp-validation-for="Position"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Photo" class="form-label"></label>
                            <input asp-for="Photo" class="form-control" type="file">
                            <span class="text-danger" asp-validation-for="Photo"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label for="EventSelect" class="form-label">Events</label>
                            <select class="form-select form-select-lg" asp-for="EventId" asp-items="@ViewBag.Events">
                            </select>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary mr-2">Update</button>
                            <a asp-action="index" class="btn btn-secondary">Go Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
