@using EduHome.Areas.AdminArea.ViewModels.SpeakerVMs
@model PaginationVM<SpeakerListVM>

@{
    ViewData["Title"] = "Speakers List";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-lg-12">
            <div class="card shadow-sm border-light">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Speakers List</h4>
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Position</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var speaker in Model)
                                {
                                    <tr>
                                        <td>
                                            <img src="~/img/event/@speaker.Image" alt="Speaker Image" class="img-fluid" style="width: 100px; height: 100px; object-fit: cover;" class="rounded" />
                                        </td>
                                        <td>@speaker.Name</td>
                                        <td>@speaker.Position</td>
                                        <td>
                                            <a class="btn btn-info btn-sm" asp-action="detail" asp-route-id="@speaker.Id"><i class="mdi mdi-eye"></i></a>
                                            <a class="btn btn-warning btn-sm" asp-action="update" asp-route-id="@speaker.Id"><i class="mdi mdi-pencil"></i></a>
                                            <a class="btn btn-danger btn-sm" asp-action="delete" asp-route-id="@speaker.Id"><i class="mdi mdi-delete"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                    <a class="page-link" asp-action="index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (int i = Model.Start; i <= Model.End; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="index" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
