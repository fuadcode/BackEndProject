@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="text-center dashboard-title">Dashboard</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <div class="icon bg-primary text-white mb-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <h5 class="card-title text-white">Total User Count</h5>
                    <p class="card-text display-4">@ViewBag.UserCount</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <div class="icon bg-success text-white mb-3">
                        <i class="fas fa-rocket fa-2x"></i>
                    </div>
                    <h5 class="card-title text-white">Total Subscription Count</h5>
                    <p class="card-text display-4">@ViewBag.SubscriptionCount</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <div class="icon bg-danger text-white mb-3">
                        <i class="fas fa-envelope fa-2x"></i>
                    </div>
                    <h5 class="card-title text-white">Total Message Count</h5>
                    <p class="card-text display-4">@ViewBag.MessageForms</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <div class="icon bg-warning text-white mb-3">
                        <i class="fas fa-shopping-cart fa-2x"></i>
                    </div>
                    <h5 class="card-title text-white">Total Request Count</h5>
                    <p class="card-text display-4">@ViewBag.BuyingRequests</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome CDN for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    /* Custom styles for the dashboard */
    body {
        background: linear-gradient(135deg, #1a1a1a, #333);
        color: #e0e0e0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dashboard-title {
        color: #ffffff;
        margin-bottom: 30px;
        font-weight: 700;
        font-size: 4rem;
        background: linear-gradient(45deg, #ff007f, #ffb700);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.4), 0 0 15px rgba(0, 0, 0, 0.3);
        letter-spacing: 2px;
        position: relative;
        display: inline-block;
        overflow: hidden;
        transition: transform 0.4s, text-shadow 0.4s;
        text-align: center;
    }

        .dashboard-title::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.15);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s;
            z-index: 0;
        }

        .dashboard-title:hover::before {
            transform: scaleX(1);
        }

        .dashboard-title:hover {
            transform: scale(1.1);
            text-shadow: 3px 3px 8px rgba(0, 0, 0, 0.5), 0 0 25px rgba(0, 0, 0, 0.4);
        }

    .card {
        background: linear-gradient(145deg, #1e1e1e, #2e2e2e);
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s, box-shadow 0.3s, background 0.3s;
        position: relative;
        overflow: hidden;
    }

        .card:hover {
            transform: translateY(-10px) scale(1.05);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            background: linear-gradient(145deg, #2e2e2e, #3e3e3e);
        }

    .card-body {
        padding: 40px;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .card-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 15px;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    }

    .card-text {
        font-size: 2.5rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .display-4 {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .icon {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        font-size: 2rem;
        transition: background 0.3s, box-shadow 0.3s, transform 0.3s;
    }

        .icon:hover {
            background: rgba(255, 255, 255, 0.3);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
            transform: rotate(15deg);
        }

    .bg-primary {
        background-color: #007bff;
    }

    .bg-success {
        background-color: #28a745;
    }

    .bg-danger {
        background-color: #dc3545;
    }

    .bg-warning {
        background-color: #ffc107;
    }

    .container {
        padding: 20px;
    }

    .row {
        margin-top: 20px;
    }

</style>
