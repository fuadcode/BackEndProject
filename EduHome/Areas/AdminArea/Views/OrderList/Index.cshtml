@model PaginationVM<OrderVM>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order List</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css">
    <style>
        .order-table img {
            width: 100px;
            height: auto;
            border-radius: 8px;
        }

        .order-table td, .order-table th {
            vertical-align: middle;
            text-align: center;
        }

        .order-table .delete-btn {
            color: #dc3545;
            border: none;
            background: none;
            cursor: pointer;
            font-size: 14px;
        }

            .order-table .delete-btn:hover {
                text-decoration: underline;
            }

        .order-table th {
            background-color: #343a40;
            color: #ffffff;
            font-weight: bold;
        }

        .order-table tbody tr:hover {
            background-color: #f1f1f1;
        }

        .delete-btn i {
            margin-right: 5px;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2 class="mb-4 text-center">Order List</h2>
        <table class="table table-bordered order-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Course</th>
                    <th>Description</th>
                    <th>Order Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(order.CourseImageUrl))
                            {
                                <img src="~/img/course/@order.CourseImageUrl" alt="Course Image" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>
                        <td>@order.CourseName</td>
                        <td>@order.CourseDesc</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <form asp-action="RemoveOrder" asp-route-orderId="@order.OrderId" method="post" style="display:inline;">
                                <button type="submit" class="delete-btn">
                                    <i class="fa fa-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
</body>
</html>
<div class="row justify-content-center">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
