@model PaginationVM<BuyingRequest>

@{
    ViewData["Title"] = "Manage Buying Requests";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">Manage Course Selling</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Course Name</th>
                        <th>User Name</th>
                        <th>Description</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th colspan="2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.Id</td>
                            <td>@request.CourseName</td>
                            <td>@request.UserName</td>
                            <td>@request.Desc</td>
                            <td>@request.RequestDate.ToString("MM/dd/yyyy")</td>
                            <td>
                                <span class="badge
                                    @(request.Status == "Accepted" ? "bg-success" :
                                      request.Status == "Rejected" ? "bg-danger" : "bg-warning")">
                                    @request.Status
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <form method="post" asp-action="Accept" asp-route-id="@request.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-success btn-sm">Accept</button>
                                    </form>
                                    <form method="post" asp-action="Reject" asp-route-id="@request.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                    </form>
                                    <form method="post" asp-action="Delete" asp-route-id="@request.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <form method="post" asp-action="Reply" asp-route-id="@request.Id">
                                    <div class="input-group">
                                        <textarea name="replyMessage" class="form-control" rows="2" placeholder="Enter your reply" required></textarea>
                                        <button type="submit" class="btn btn-primary">Send</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row justify-content-center">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
