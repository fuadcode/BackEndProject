@using EduHome.Areas.AdminArea.ViewModels.EventVMs
@model PaginationVM<EventListVM>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="card-title">Event List</h4>
                        <a class="btn btn-primary" asp-action="create">
                            <i class="mdi mdi-plus-circle"></i> Create New Event
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Area</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ev in Model)
                                {
                                    <tr>
                                        <td><img src="~/img/event/@ev.ImgUrl" alt="Event Image" class="img-fluid" style="width: 100px; height: auto;" /></td>
                                        <td>@ev.Name</td>
                                        <td>@ev.Desc</td>
                                        <td>@ev.Area</td>
                                        <td>@ev.CreatedDate?.ToString("dd MMMM yyyy")</td>
                                        <td>
                                            <a class="btn btn-info btn-sm" asp-action="detail" asp-route-id="@ev.Id"><i class="mdi mdi-eye"></i></a>
                                            <a class="btn btn-warning btn-sm" asp-action="update" asp-route-id="@ev.Id"><i class="mdi mdi-pencil"></i></a>
                                            <a class="btn btn-danger btn-sm" asp-action="delete" asp-route-id="@ev.Id"><i class="mdi mdi-delete"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3 justify-content-center">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (int i = Model.Start; i <= Model.End; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
