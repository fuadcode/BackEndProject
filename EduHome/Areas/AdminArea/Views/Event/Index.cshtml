@using EduHome.Areas.AdminArea.ViewModels.EventVMs
@model PaginationVM<EventListVM>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <a class="btn btn-outline-github" asp-action="create">
                Create
            </a>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Desc</th>
                            <th>Area</th>
                            <th>Time</th>
                            <th>Settings</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td><img src="~/img/event/@ev.ImgUrl" alt="" /></td>
                                <td>@ev.Name</td>
                                <td>@ev.Desc</td>
                                <td>@ev.Area</td>
                                <td>@ev.CreatedDate?.ToString("dd.MMMM.yyyy")</td>
                                <td>
                                    <a class="btn btn-outline-facebook" asp-action="detail" asp-route-id="@ev.Id"><i class="mdi mdi-account-card-details"></i></a>
                                    <a class="btn btn-outline-primary" asp-action="update" asp-route-id="@ev.Id"><i class="mdi mdi-settings"></i></a>
                                    <a class="btn btn-outline-danger" asp-action="delete" asp-route-id="@ev.Id"><i class="mdi mdi-delete"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
