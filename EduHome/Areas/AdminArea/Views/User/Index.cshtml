@using EduHome.Areas.AdminArea.ViewModels.UserVms
@using EduHome.Models
@model PaginationVM<AppUser>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="card-title mb-0">User Management</h4>
                        <a class="btn btn-success btn-lg text-white" asp-action="create">
                            <i class="mdi mdi-plus-circle-outline"></i> Create User
                        </a>
                    </div>

                    <div class="mb-4">
                        <form asp-action="index" class="form-inline">
                            <div class="input-group w-50">
                                <input type="text" class="form-control" name="searchtext" placeholder="Search by username or email" />
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-primary">Search</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th>Full Name</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>@user.FullName</td>
                                        <td>@user.UserName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            @if (user.IsBlocked)
                                            {
                                                <span class="badge badge-danger">Blocked</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (User.Identity.Name != user.UserName)
                                            {
                                                <a class="btn btn-warning btn-sm" asp-action="changeStatus" asp-route-id="@user.Id" title="Change Status">
                                                    <i class="mdi mdi-refresh"></i>
                                                </a>
                                                <a class="btn btn-primary btn-sm" asp-action="update" asp-route-id="@user.Id" title="Update">
                                                    <i class="mdi mdi-pencil"></i>
                                                </a>
                                                <a class="btn btn-info btn-sm" asp-action="detail" asp-route-id="@user.Id" title="Details">
                                                    <i class="mdi mdi-eye"></i>
                                                </a>
                                                <a class="btn btn-danger btn-sm" asp-action="delete" asp-route-id="@user.Id" title="Delete">
                                                    <i class="mdi mdi-delete"></i>
                                                </a>
                                                <a class="btn btn-secondary btn-sm" asp-action="updateuserrole" asp-controller="Role" asp-route-id="@user.Id" title="Update Role">
                                                    <i class="mdi mdi-account-edit"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Pagination Section -->
<div class="row justify-content-center mt-4">
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-md">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)" aria-label="Previous">
                    <span aria-hidden="true" class="pagination-icon">&laquo;</span>
                    <span class="sr-only">Previous</span>
                </a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)" aria-label="Next">
                    <span aria-hidden="true" class="pagination-icon">&raquo;</span>
                    <span class="sr-only">Next</span>
                </a>
            </li>
        </ul>
    </nav>
</div>


<style>
    .pagination {
        display: flex;
        justify-content: center;
        padding: 1rem;
    }

        .pagination .page-item {
            margin: 0 0.2rem;
        }

        .pagination .page-link {
            border-radius: 0.375rem;
            border: 1px solid #dee2e6;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: #007bff;
            background-color: #fff;
        }

            .pagination .page-link:hover {
                background-color: #e9ecef;
                color: #0056b3;
            }

        .pagination .page-item.active .page-link {
            background-color: red;
            color: #fff;
            border-color: black;
        }

        .pagination .page-item.disabled .page-link {
            color: #6c757d;
            cursor: not-allowed;
        }

    .pagination-icon {
        font-size: 1.2rem;
    }
</style>