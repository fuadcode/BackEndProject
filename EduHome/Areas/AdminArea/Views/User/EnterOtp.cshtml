@model VerifyOTPVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter OTP</title>
    <link rel="shortcut icon" href="./admin/images/otp-icon.png" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,500" rel="stylesheet">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background: #111;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        .container {
            background: #222;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 0 30px rgba(0, 255, 204, 0.5);
            position: relative;
            text-align: center;
        }

        h1 {
            color: #0ff;
            font-size: 28px;
            margin-bottom: 20px;
            animation: neon 1.5s ease-in-out infinite alternate;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            color: #eee;
            font-size: 16px;
        }

        .form-group input[type="text"] {
            width: calc(100% - 20px);
            padding: 15px;
            border: 1px solid #0ff;
            border-radius: 8px;
            background: #111;
            color: #fff;
            font-size: 18px;
            box-sizing: border-box;
            transition: border-color 0.3s ease;
            text-align: center;
            animation: pulse 1.5s infinite;
        }

        .form-group input[type="text"]:focus {
            border-color: #ff007f;
            outline: none;
        }

        .form-group button {
            width: 100%;
            padding: 15px;
            background-color: #0ff;
            border: none;
            border-radius: 8px;
            color: #111;
            font-size: 18px;
            cursor: pointer;
            transition: background-color 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.5);
        }

        .form-group button:hover {
            background-color: #ff007f;
            box-shadow: 0 0 25px rgba(255, 0, 127, 0.7);
        }

        .box-container {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .box {
            width: 50px;
            height: 50px;
            background: #0ff;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.5);
            color: #111;
            font-size: 24px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: bounce 1.5s infinite alternate;
        }

        .box:nth-child(2) { animation-delay: 0.1s; }
        .box:nth-child(3) { animation-delay: 0.2s; }
        .box:nth-child(4) { animation-delay: 0.3s; }
        .box:nth-child(5) { animation-delay: 0.4s; }
        .box:nth-child(6) { animation-delay: 0.5s; }

      
    </style>
</head>
<body>
    <div class="container">
        <h1>Enter OTP Code</h1>
        <div class="box-container">
            <div class="box">1</div>
            <div class="box">2</div>
            <div class="box">3</div>
            <div class="box">4</div>
            <div class="box">5</div>
            <div class="box">6</div>
        </div>
        <form asp-action="VerifyOtp" method="post">
            <div class="form-group">
                <label for="otpCode">OTP Code</label>
                <input type="text" id="otpCode" name="OtpCode" required />
            </div>
            <div class="form-group">
                <input type="hidden" name="Email" value="@Model.Email" />
                <input type="hidden" name="Token" value="@Model.Token" />
                <button type="submit">Verify OTP</button>
            </div>
        </form>
    </div>
</body>
</html>
