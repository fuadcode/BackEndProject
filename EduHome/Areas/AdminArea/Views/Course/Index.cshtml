@using EduHome.Areas.AdminArea.ViewModels.CourseVMs
@{
    ViewData["Title"] = "Index";
}

@model PaginationVM<CourseListVM>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card shadow-sm">
        <div class="card-body">
            <a class="btn btn-success mb-4" asp-action="create">
                <i class="mdi mdi-plus-box"></i> Create New Course
            </a>
            <div class="table-responsive">
                <table class="table table-hover text-center">
                    <thead class="thead-light">
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Desc</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>
                                    <img src="~/img/course/@course.ImgUrl" alt="" class="img-fluid rounded-circle" style="width: 60px; height: 60px; object-fit: cover;" />
                                </td>
                                <td>
                                    @course.Name
                                </td>
                                <td>
                                    @course.Desc
                                </td>
                                <td>
                                    @course.Date?.ToString("dd.MMMM.yyyy")
                                </td>
                                <td>
                                    <a class="btn btn-info btn-sm mr-1" asp-action="detail" asp-route-id="@course.Id" title="View Details">
                                        <i class="mdi mdi-account-card-details"></i>
                                    </a>
                                    <a class="btn btn-warning btn-sm mr-1" asp-action="update" asp-route-id="@course.Id" title="Edit Course">
                                        <i class="mdi mdi-settings"></i>
                                    </a>
                                    <a class="btn btn-danger btn-sm" asp-action="delete" asp-route-id="@course.Id" title="Delete Course">
                                        <i class="mdi mdi-delete"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <nav aria-label="Pagination">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="index" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
