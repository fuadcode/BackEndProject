@using EduHome.Areas.AdminArea.ViewModels.CourseVMs
@model CourseDetailVM

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <img src="/img/course/courses-details.jpg" class="img-fluid mb-4" alt="Course Image" style="border-radius: 8px; max-width: 100%; height: auto;" />

                    <h2 class="card-title mb-3">@Model.Name</h2>

                    <p class="card-text text-muted">
                        <strong>Course Description:</strong> @Model.Desc
                    </p>

                    <a asp-action="index" class="btn btn-outline-dark mt-4">Go Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
