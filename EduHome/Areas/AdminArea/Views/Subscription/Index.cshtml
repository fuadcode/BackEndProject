@model PaginationVM<Subscription>

<div class="container mt-5">
    <h2 class="text-center mb-4">Subscriptions</h2>
    <div class="row">
        @foreach (var subscription in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title">@subscription.Email</h5>
                        <p class="card-text">
                            <small class="text-muted">Subscribed on @subscription.SubscriptionDate.ToString("MMMM dd, yyyy HH:mm:ss")</small>
                        </p>
                        <form asp-action="Delete" method="post" class="mt-3">
                            <input type="hidden" name="id" value="@subscription.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                <i class="fas fa-trash-alt"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center">
                <p>No subscriptions found.</p>
            </div>
        }
    </div>
    <div class="row justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">
                        <i class="fas fa-chevron-left"></i> Previous
                    </a>
                </li>
                @for (int i = Model.Start; i <= Model.End; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">
                        Next <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>
