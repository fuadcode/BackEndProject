@using EduHome.Areas.AdminArea.ViewModels.BlogVMs
@model PaginationVM<BlogListVM>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <a class="btn btn-success mb-3" asp-action="create">
                <i class="mdi mdi-plus-circle"></i> Create New Blog
            </a>
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>DescriptionPart</th>
                            <th>Comments</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var blog in Model)
                        {
                            <tr>
                                <td><img src="~/img/blog/@blog.ImgUrl" alt="" style="width: 60px; height: 60px; object-fit: cover;" /></td>
                                <td>@blog.Name</td>
                                <td>@blog.Desc</td>
                                <td>@blog.DescPart</td>
                                <td>@blog.Comment</td>
                                <td>@blog.Time.ToString("dd.MMMM.yyyy")</td>
                                <td>
                                    <a class="btn btn-info btn-sm" asp-action="detail" asp-route-id="@blog.Id" title="View Details">
                                        <i class="mdi mdi-eye"></i> View
                                    </a>
                                    <a class="btn btn-warning btn-sm" asp-action="update" asp-route-id="@blog.Id" title="Edit Blog">
                                        <i class="mdi mdi-pencil"></i> Edit
                                    </a>
                                    <a class="btn btn-danger btn-sm" asp-action="delete" asp-route-id="@blog.Id" title="Delete Blog">
                                        <i class="mdi mdi-delete"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
