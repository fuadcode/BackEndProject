@using EduHome.Areas.AdminArea.ViewModels.SliderVMs
@model SliderListVM

@{
    Layout = "~/Areas/AdminArea/Views/Shared/_AdminLayout.cshtml";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="card-title mb-0">@Model.Title</h3>
                </div>
                <img src="~/img/slider/@Model.ImgUrl" class="card-img-top" alt="Slider Image" style="height: 400px; object-fit: cover; border-radius: 0;" />
                <div class="card-body p-4">
                    <h4 class="card-subtitle mb-2 text-muted">Description:</h4>
                    <p class="card-text">@Model.Desc</p>
                    <div class="text-center mt-4">
                        <a asp-action="index" class="btn btn-outline-secondary btn-lg">Go Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/validation.js"></script>
}
