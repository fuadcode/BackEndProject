@using EduHome.Areas.AdminArea.ViewModels.SliderVMs
@model SliderCreateVM

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-5">
                    <h3 class="card-title text-center mb-4 text-uppercase text-primary">Create New Slider</h3>
                    <form enctype="multipart/form-data" asp-action="create" method="post" class="forms-sample">

                        <div class="form-group">
                            <label asp-for="Photo" class="form-label text-muted">Upload Photo</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-0" id="inputGroupFileAddon01">
                                        <i class="mdi mdi-upload"></i>
                                    </span>
                                </div>
                                <input asp-for="Photo" class="form-control border-0" placeholder="Select a photo" aria-describedby="inputGroupFileAddon01">
                            </div>
                            <span class="text-danger" asp-validation-for="Photo"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Title" class="form-label text-muted">Title</label>
                            <input asp-for="Title" class="form-control border-0 shadow-sm" placeholder="Enter slider title">
                            <span class="text-danger" asp-validation-for="Title"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Desc" class="form-label text-muted">Description</label>
                            <textarea asp-for="Desc" class="form-control border-0 shadow-sm" placeholder="Enter description" rows="4"></textarea>
                            <span class="text-danger" asp-validation-for="Desc"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5">Create</button>
                            <a asp-action="index" class="btn btn-outline-secondary btn-lg">Go Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
