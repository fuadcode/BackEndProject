@using EduHome.Areas.AdminArea.ViewModels.SliderVMs
@model PaginationVM<SliderListVM>
<div class="container">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">slider Table</h4>
                    <a class="btn btn-outline-github" asp-action="create">
                        Create
                    </a>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th>Settings</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var slider in Model)
                                {
                                    <tr>
                                        <td>
                                            <img src="~/img/slider/@slider.ImgUrl"  class="rounded-0" style="width:120px ; height:120px"  alt="" />
                                        </td>
                                        <td>@slider.Title</td>
                                        <td>@slider.Desc</td>
                                        <td>
                                            <a class="btn btn-outline-facebook" asp-action="detail" asp-route-id="@slider.Id"><i class="mdi mdi-account-card-details"></i></a>
                                            <a class="btn btn-outline-primary" asp-action="update" asp-route-id="@slider.Id"><i class="mdi mdi-settings"></i></a>
                                            <a class="btn btn-outline-danger" asp-action="delete" asp-route-id="@slider.Id"><i class="mdi mdi-delete"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row justify-content-center">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>