@using EduHome.Areas.AdminArea.ViewModels.SliderVMs
@model PaginationVM<SliderListVM>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="card-title mb-0">Slider Table</h4>
                        <a class="btn btn-outline-success" asp-action="create">
                            <i class="mdi mdi-plus"></i> Create New
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th class="text-center">Image</th>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slider in Model)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <div class="img-thumbnail shadow-sm">
                                                <img src="~/img/slider/@slider.ImgUrl" style="width: 150px; height: 150px; object-fit: cover;" class="rounded" alt="@slider.Title" />
                                            </div>
                                        </td>
                                        <td>@slider.Title</td>
                                        <td>@slider.Desc</td>
                                        <td class="text-center">
                                            <a class="btn btn-outline-info btn-sm mr-2" asp-action="detail" asp-route-id="@slider.Id">
                                                <i class="mdi mdi-eye"></i> View
                                            </a>
                                            <a class="btn btn-outline-primary btn-sm mr-2" asp-action="update" asp-route-id="@slider.Id">
                                                <i class="mdi mdi-pencil"></i> Edit
                                            </a>
                                            <a class="btn btn-outline-danger btn-sm" asp-action="delete" asp-route-id="@slider.Id">
                                                <i class="mdi mdi-trash-can"></i> Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage - 1)">Previous</a>
            </li>
            @for (int i = Model.Start; i <= Model.End; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-stage="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-stage="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
